{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server/src/index.ts" }
  ],
  "functions": {
    "server/src/index.ts": {
      "includeFiles": "server/prisma/**",
      "memory": 512,
      "maxDuration": 30
    }
  }
}
