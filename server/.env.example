# Neon PostgreSQL — copiar desde neon.tech > Connection Details
# DATABASE_URL = pooled connection (para Vercel serverless)
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# DIRECT_URL = direct connection (para migraciones)
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT
JWT_SECRET="cambiar-por-una-clave-secreta-larga"

# CORS — URL del frontend en Vercel (sin barra al final)
ALLOWED_ORIGINS="https://tu-frontend.vercel.app"
